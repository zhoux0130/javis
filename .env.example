# 运行期
JAVIS_PORT=5173
JAVIS_DATA_DIR=./data
JAVIS_LOG_LEVEL=info      # debug | info | warn | error
# 设了就要鉴权（对外暴露时务必设）：请求头 x-javis-token / ?token= / cookie
JAVIS_AUTH_TOKEN=

# PostgreSQL（kei.upivot.io:65435，与 antman 同实例、独立库）
# 本机 → javis_dev；服务器 → javis_prod。部署脚本会校验服务器那份指向 javis_prod。
DATABASE_URL=postgresql://postgres:<password>@kei.upivot.io:65435/javis_dev

# 阿里云 OSS（与 antman 同 bucket；对象放在 OSS_UPLOAD_PATH/javis/ 下）
OSS_REGION=oss-cn-hangzhou
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_UPLOAD_PATH=uploads

# 微信小程序（登录 code2session 用；不要发到前端）
WX_APP_ID=
WX_APP_SECRET=
